{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/sc/api/:path*",
      "destination": "https://api-v2.soundcloud.com/:path*"
    },
    {
      "source": "/sc/web/:path*",
      "destination": "https://soundcloud.com/:path*"
    },
    { "source": "/((?!api/|sc/).*)", "destination": "/index.html" }
  ]
}
